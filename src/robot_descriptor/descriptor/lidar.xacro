<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_link"/>
        <!-- Sensor origin at the center of the assembly-coordinate OBJ mesh. -->
        <origin xyz="0.0800 -0.0030 0.1993" rpy="0 0 0"/>
    </joint>

    <link name="laser_link">
        <visual>
            <origin xyz="-0.0800 0.0030 -0.1993" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://robot_descriptor/meshes/lidar_LD06.obj" scale="0.01 0.01 0.01"/>
            </geometry>
        </visual>

        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>



    <gazebo reference="laser_link">
    <material>Gazebo/Black</material>
    <self_collide>false</self_collide>

    <sensor name="ld06" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>scan</topic>
        <gz_frame_id>laser_link</gz_frame_id>
        <lidar>

        <scan>
            <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592</min_angle>
            <max_angle>3.141592</max_angle>
            </horizontal>
        </scan>

        <range>
            <min>0.1</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
        </range>

        <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
        </noise>

        </lidar>

    </sensor>
    </gazebo>

</robot>
